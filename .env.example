# KaneVerity environment configuration (example)
#
# Copy this file to `.env` and fill in values for your machine.
# `.env` is git-ignored. Never commit real paths, credentials or tokens.

# --- Kane CLI ---
# Kane CLI drives a locally installed Google Chrome. If Chrome is not in the
# default location for your OS, point Kane at the executable here.
#   Windows (system install):   C:\Program Files\Google\Chrome\Application\chrome.exe
#   Windows (per-user install): <your-user-profile>\AppData\Local\Google\Chrome\Application\chrome.exe
#   macOS:                      /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:                      /usr/bin/google-chrome
# Leave blank to use Kane's default detection.
KANE_CLI_CHROME_PATH=

# Kane CLI authentication is NOT configured here.
# Run `kane-cli login --oauth` yourself; Kane stores credentials in its own
# profile directory outside this repository. Check with `kane-cli whoami`.

# --- KaneVerity orchestrator (optional; defaults shown) ---
# MVP scope: live verification only runs against the controlled local demo.
# KANEVERITY_ALLOWED_DOCS_ORIGINS=http://127.0.0.1:5175
# KANEVERITY_ALLOWED_APP_ORIGINS=http://127.0.0.1:5174
# Only needed if Kane CLI isn't in the default global npm location.
# KANE_CLI_ENTRY=<path-to>/node_modules/@testmuai/kane-cli/bin/kane-cli.cjs
